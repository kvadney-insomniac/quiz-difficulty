{
  "name": "quiz-difficulty",
  "version": "1.0.0",
  "description": "Build easy/medium/hard option sets for multiple-choice questions from rings of candidate answers, deterministically and without accidentally making hard mode easier.",
  "keywords": [
    "quiz",
    "distractors",
    "multiple-choice",
    "difficulty",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvadney-insomniac/quiz-difficulty.git"
  },
  "homepage": "https://github.com/kvadney-insomniac/quiz-difficulty#readme",
  "bugs": {
    "url": "https://github.com/kvadney-insomniac/quiz-difficulty/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
