{
  "name": "quiz-difficulty",
  "version": "1.1.3",
  "description": "Build easy/medium/hard option sets for multiple-choice questions from rings of candidate answers, deterministically and without accidentally making hard mode easier.",
  "keywords": [
    "quiz",
    "distractors",
    "multiple-choice",
    "difficulty",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvadney-insomniac/quiz-difficulty.git"
  },
  "homepage": "https://github.com/kvadney-insomniac/quiz-difficulty#readme",
  "bugs": {
    "url": "https://github.com/kvadney-insomniac/quiz-difficulty/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-dashes.mjs",
    "check-version": "node scripts/check-version.mjs",
    "test": "vitest run",
    "example": "vitest run test/example.test.ts --reporter=verbose",
    "prepublishOnly": "npm run check && npm run lint && npm test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
