{
  "name": "quiz-difficulty",
  "version": "0.1.0",
  "description": "Build easy/medium/hard option sets for multiple-choice questions from rings of candidate answers, deterministically and without accidentally making hard mode easier.",
  "keywords": [
    "quiz",
    "distractors",
    "multiple-choice",
    "difficulty",
    "flashcards",
    "spaced-repetition"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
